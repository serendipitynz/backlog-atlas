# macOS code signing and notarization credentials.
#
# Copy this file to `.env.signing` (git-ignored), fill in the values, then run:
#     ./scripts/macos-sign-build.sh
#
# `pnpm tauri build` reads these as environment variables and, when they are
# set, signs the .app with hardened runtime (`bundle.macOS.hardenedRuntime`
# defaults to true), submits it to Apple's notary service, and staples the
# ticket. With none of them set the build still succeeds and produces an
# unsigned bundle — nothing here is needed to build from source.
#
# Prerequisites (see AGENTS.md "Release"):
#   - Xcode Command Line Tools (`xcode-select --install`).
#   - A "Developer ID Application" certificate and its private key in the login
#     keychain. Check with:  security find-identity -v -p codesigning
#     Only "Developer ID Application" can be notarized for distribution outside
#     the App Store; "Apple Development" and "Apple Distribution" cannot.

# --- Signing ---------------------------------------------------------------
# Which certificate to sign with: the certificate's SHA-1 hash (unambiguous when
# several certificates share a name) or its full common name
# ("Developer ID Application: <Name> (<TEAMID>)").
export APPLE_SIGNING_IDENTITY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# --- Notarization ----------------------------------------------------------
# The Apple ID that owns the signing team, an app-specific password for it
# (appleid.apple.com > Sign-In and Security > App-Specific Passwords), and the
# 10-character team ID.
#
# Tauri also accepts an App Store Connect API key instead
# (APPLE_API_KEY / APPLE_API_ISSUER / APPLE_API_KEY_PATH). Atlas uses the
# app-specific password because that is what the .p12 export flow in
# scripts/setup-ci-signing-secrets.sh already carries; adding the key path
# would put a second credential shape in the same file with nothing to choose
# between them.
export APPLE_ID="you@example.com"
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
export APPLE_TEAM_ID="XXXXXXXXXX"
